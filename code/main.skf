// skyforge-diff

функция расстояние_левенштейна(a, b) {
    пусть len_a = длина(a)
    пусть len_b = длина(b)
    
    если len_a == 0 { вернуть len_b }
    если len_b == 0 { вернуть len_a }
    
    пусть предыдущая = []
    для i от 0 до len_b {
        предыдущая = предыдущая + [i]
    }
    
    для i от 1 до len_a {
        пусть текущая = [i]
        для j от 1 до len_b {
            пусть символ_a = подстрока(a, i - 1, i)
            пусть символ_b = подстрока(b, j - 1, j)
            
            пусть стоимость = 0
            если символ_a != символ_b { стоимость = 1 }
            
            пусть вставка = текущая[j - 1] + 1
            пусть удаление = предыдущая[j] + 1
            пусть замена = предыдущая[j - 1] + стоимость
            
            пусть минимум = вставка
            если удаление < минимум { минимум = удаление }
            если замена < минимум { минимум = замена }
            
            текущая = текущая + [минимум]
        }
        предыдущая = текущая
    }
    
    вернуть предыдущая[длина(предыдущая) - 1]
}

функция похожесть(a, b) {
    если a == b { вернуть 1.0 }
    пусть max_len = длина(a)
    если длина(b) > max_len { max_len = длина(b) }
    если max_len == 0 { вернуть 1.0 }
    
    пусть расстояние = расстояние_левенштейна(a, b)
    вернуть 1.0 - расстояние / max_len
}
